# Review alongside render.yaml; this example has not been deployed.
services:
  - type: worker
    name: crewcrate-worker-push
    runtime: python
    buildCommand: pip install .
    startCommand: python -m app.worker_push
    envVars:
      - key: DATABASE_URL
        sync: false
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_PUBLISHABLE_KEY
        sync: false
      - key: APNS_KEY_ID
        sync: false
      - key: APNS_TEAM_ID
        sync: false
      - key: APNS_TOPIC
        value: com.CrewCrate.CrewCrate
      - key: APNS_PRIVATE_KEY
        sync: false
