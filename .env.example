# Use Supabase's transaction-pooler URL, adapted for asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=crewcrate_media
ALLOWED_ORIGINS=https://your-client-portal.example.com
AUTO_CREATE_SCHEMA=false
